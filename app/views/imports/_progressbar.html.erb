<%# locals: (import: , current:) %>
<div id="import-progress"
   role="progressbar"
   data-controller="imports--run"
   data-runpath="<%= import_run_path(import, format: :js) %>"
   aria-valuemin="0"
   class="ui-progressbar ui-corner-all ui-widget ui-widget-content"
   aria-valuemax="<%= import.total_items.to_i %>"
   aria-valuenow="<%= current %>">
   <div id="progress-label" data-imports--run-target="label"><%= current %> / <%= import.total_items.to_i %></div>
   <div class="ui-progressbar-value ui-corner-left ui-widget-header" style="width: <%= current / import.total_items.to_i * 100 if import.total_items.to_i > 0 %>%;"></div>
</div>
