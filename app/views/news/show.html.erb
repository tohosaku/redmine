<%= breadcrumb link_to(l(:label_news_plural), project_news_index_path(@project)) %>
<div class="contextual">
<%= watcher_link(@news, User.current) %>
<%= link_to(sprite_icon('edit', l(:button_edit)),
      edit_news_path(@news),
      :class => 'icon icon-edit',
      :accesskey => accesskey(:edit),
      :data => {:controller => 'command', :action => 'command#execute command:show->relay#forward', :command_name_param => 'show'}) if User.current.allowed_to?(:manage_news, @project) %>
<%= delete_link news_path(@news) if User.current.allowed_to?(:manage_news, @project) %>
</div>

<h2><%= avatar(@news.author) %> <%=h @news.title %></h2>

<% if authorize_for('news', 'edit') %>
<div id="edit-news" style="display:none;" data-controller="visibility" data-action="command:show->visibility#show" data-relay-events="command:show">
<%= labelled_form_for :news, @news, :url => news_path(@news),
                                           :html => { :id => 'news-form', :multipart => true, :method => :put } do |f| %>
<%= render :partial => 'form', :locals => { :f => f } %>
<%= submit_tag l(:button_save) %>
<%= link_to l(:button_cancel), "#", data: { action: 'visibility#hide' } %>
<% end %>
</div>
<% end %>

<div class="news">
  <div class="reaction">
    <%= reaction_button @news %>
  </div>
  <p><% unless @news.summary.blank? %><em><%= @news.summary %></em><br /><% end %>
  <span class="author"><%= authoring @news.created_on, @news.author %></span></p>
  <div class="wiki">
  <%= textilizable(@news, :description) %>
  </div>
  <%= link_to_attachments @news %>
</div>
<br />

<div id="comments" class="journals">
<h3 class="comments"><%= l(:label_comment_plural) %></h3>
<% if @news.commentable? && @comments.size >= 3 %>
  <p><%= toggle_link l(:label_comment_add), 'add_comment_form', scroll: 'true' %></p>
<% end %>
<% @comments.each do |comment| %>
    <div class="message reply journal" id="<%= "message-#{comment.id}" %>">
      <% next if comment.new_record? %>
      <h4 class="reply-header journal-header">
        <span class="journal-info">
          <%= avatar(comment.author) %>
          <%= authoring comment.created_on, comment.author %>
        </span>
        <span class="journal-meta">
          <%= reaction_button comment %>
          <%= link_to_if_authorized sprite_icon('del', l(:button_delete)), { :controller => 'comments', :action => 'destroy', :id => @news, :comment_id => comment},
                                    :data => {:confirm => l(:text_are_you_sure)}, :method => :delete,
                                    :title => l(:button_delete),
                                    :class => 'icon-only icon-del' %>
        </span>
      </h4>
      <div class="wiki journal-content">
        <%= textilizable(comment.comments) %>
      </div>
    </div>
<% end if @comments.any? %>
</div>

<% if @news.commentable? %>
  <p><%= toggle_link l(:label_comment_add), 'add_comment_form' %></p>
  <%= form_tag({:controller => 'comments', :action => 'create', :id => @news}, :id => "add_comment_form", :style => "display:none;",
                :data => { :controller => 'scroll focus', :action => 'visibility:toggle->scroll#scroll visibility:toggle->focus#focus' } ) do %>
<div class="box">
  <%= component 'wikieditor', preview_url: preview_news_path(project_id: @project, id: @news) do |d| %>
    <%= textarea_tag 'comment', nil, cols: 80, rows: 15, class: 'wiki-edit',
          data: d.merge({
            controller: 'inline-autocomplete',
            focus_target: 'point'
        }) %>
  <% end %>
</div>
<p><%= submit_tag l(:button_add) %></p>
<% end %>
<% end %>

<% html_title @news.title -%>

<% content_for :header_tags do %>
  <%= stylesheet_link_tag 'scm' %>
<% end %>
