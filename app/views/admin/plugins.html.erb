<%= title l(:label_plugins) %>

<% if @plugins.any? %>
<%= tag.div data: { controller: "admin--plugins",
          admin__plugins_latest_value: l(:label_latest_compatible_version),
          admin__plugins_unknown_value: l(:label_unknown_plugin),
          admin__plugins_error_value: 'Unable to retrieve plugin informations from www.redmine.org',
          admin__plugins_url_value: 'https://www.redmine.org/plugins/check_updates',
          admin__plugins_data_value: plugin_data_for_updates(@plugins).to_json} do %>
<div class="autoscroll">
  <table class="list plugins" data-admin--plugins-target="list">
      <thead><tr>
        <th><%= l(:field_name) %> / <%= l(:field_description) %></th>
        <th><%= l(:field_author) %></th>
        <th><%= l(:label_version) %></th>
        <th></th>
      </tr></thead>
      <tbody>
      <% @plugins.each do |plugin| %>
          <tr id="plugin-<%= plugin.id %>">
          <td class="name"><span class="name"><%= plugin.name %></span>
              <%= content_tag('span', plugin.description, :class => 'description') unless plugin.description.blank? %>
              <%= content_tag('span', link_to(plugin.url, plugin.url), :class => 'url') unless plugin.url.blank? %>
          </td>
          <td class="author"><%= plugin.author_url.blank? ? plugin.author : link_to(plugin.author, plugin.author_url) %></td>
          <td class="version"><span class="icon" data-admin--plugins-target="version" data-plugin-id="<%= plugin.id %>"><%= plugin.version %></span></td>
          <td class="configure"><%= link_to(l(:button_configure), plugin_settings_path(plugin)) if plugin.configurable? %></td>
          </tr>
      <% end %>
      </tbody>
  </table>
</div>
<p>
<%= link_to l(:label_check_for_updates), '#', id: "check-for-updates", data: {action: "click->admin--plugins#checkForUpdates"} if @plugins.any? %>
</p>
<% end %>
<% else %>
  <p class="nodata"><%= l(:label_no_data) %></p>
<% end %>
