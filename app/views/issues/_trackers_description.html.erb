<% if trackers.any? {|t| t.description.present? } %>
  <% component 'modal_dialog', id: 'trackers_description', title: l(:label_trackers_description) do %>
    <dl>
    <% trackers.each do |tracker| %>
      <% if tracker.description.present? %>
        <dt><%= link_to tracker.name, '#', data: { action: 'issues--select#select dialog#hide', issues__select_id_param: tracker.id }, title: l(:text_select_apply_tracker) %></dt>
        <dd><%= tracker.description %></dd>
      <% end %>
    <% end %>
    </dl>
  <% end %>
<% end %>
