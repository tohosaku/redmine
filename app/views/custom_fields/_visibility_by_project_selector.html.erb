<fieldset class="box" data-controller="conditional-attribute">
  <legend><%= toggle_checkboxes_link("#custom_field_project_ids input[type=checkbox]:enabled") %><%= l(:label_project_plural) %></legend>
  <p><%= f.check_box :is_for_all, :data => conditional_attribute.toggle_disabled(equal_to: '1') %></p>

  <div id="custom_field_project_ids">
    <% project_ids = @custom_field.project_ids.to_a %>
    <%= render_project_nested_lists(Project.all) do |p| %>
      <label>
        <%= check_box_tag('custom_field[project_ids][]', p.id, project_ids.include?(p.id), id: nil,
                          data: conditional_attribute.element) +
                          ' ' + p.to_s %>
      </label>
    <% end %>
    <%= hidden_field_tag('custom_field[project_ids][]', '', :id => nil) %>
  </div>
</fieldset>
