<% tag_id = tag_name.gsub(/[\[\]]+/, '_').sub(/_+$/, '') %>
<% available_tag_id = "available_#{tag_id}" %>
<% selected_tag_id = "selected_#{tag_id}" %>
<% filter ||= nil %>

<%= tag.div data: {controller: "queries--columns queries--selected"} do %>
<div class="query-columns">
      <%= label_tag available_tag_id, l(:description_available_columns) %>
      <%= select_tag 'available_columns',
              options_for_select(query_available_inline_columns_options(query, filter)),
              :id => available_tag_id,
              :multiple => true, :size => 10,
              :data => { :action => 'dblclick->queries--columns#moveOptions',
                         :queries__columns_from_param => available_tag_id,
                         :queries__columns_to_param => selected_tag_id }.merge!(data) %>
</div>
<%= tag.div class: 'buttons' do %>
  <%= tag.input value: raw("&#8594;"), type: 'button', class: "move-right", data: { action: 'click->queries--columns#moveOptions', queries__columns_from_param: available_tag_id, queries__columns_to_param: selected_tag_id } %>
  <%= tag.input value: raw("&#8592;"), type: 'button', class: "move-left",  data: { action: 'click->queries--columns#moveOptions', queries__columns_from_param: selected_tag_id,  queries__columns_to_param: available_tag_id } %>
<% end %>
<div class="query-columns">
      <%= label_tag selected_tag_id, l(:description_selected_columns) %>
      <%= select_tag tag_name,
              options_for_select(query_selected_inline_columns_options(query)),
              :id => selected_tag_id,
              :multiple => true, :size => 10,
              :data => { :controller => 'queries--columns-submit',
                         :queries__selected_target => 'select',
                         :action => 'dblclick->queries--columns#moveOptions',
                         :queries__columns_from_param => selected_tag_id,
                         :queries__columns_to_param => available_tag_id }.merge!(data) %>
</div>
<%= tag.div class: 'buttons', data: {queries__selected_target: 'select'} do %>
  <%= tag.input value: raw("&#8648;"), type: 'button', data: { action: 'click->queries--selected#moveOptionTop' } %>
  <%= tag.input value: raw("&#8593;"), type: 'button', data: { action: 'click->queries--selected#moveOptionUp' } %>
  <%= tag.input value: raw("&#8595;"), type: 'button', data: { action: 'click->queries--selected#moveOptionDown' } %>
  <%= tag.input value: raw("&#8650;"), type: 'button', data: { action: 'click->queries--selected#moveOptionBottom' } %>
<% end %>
<% end %>
