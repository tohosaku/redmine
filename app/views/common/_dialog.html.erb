<%# locals: (id: nil, title: '', data: nil) %>
<%= tag.div style: 'display:none', class: 'dialog', id: id, data: (data || {}).with_defaults( controller: 'dialog draggable',
                                                                                              action: 'dialog:start->draggable#start
                                                                                                       dialog:end->draggable#end
                                                                                                       dialog:end->draggable#ensurePosition') do %>
  <%= tag.div class: "handle", data: {dialog_target: 'handle',
                                      draggable_target: 'handle',
                                      action: 'pointerdown->dialog#start
                                               pointerup->dialog#end
                                               pointercancel->dialog#end
                                               pointermove->draggable#move
                                               keydown.esc@window->dialog#cancel'} do %>
    <span class="title"><%= title %></span>
    <%= tag.button type: "button", title: l(:button_close_dialog), data: {action: "dialog#cancel", dialog_target: 'cancel'} do %>
      <%= sprite_icon 'close-dialog'%>
    <% end %>
  <% end %>
  <div class="dialog-content">
    <%= yield %>
  </div>
<% end %>
