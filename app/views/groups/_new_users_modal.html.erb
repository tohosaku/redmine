<%= form_for(@group, url: group_users_path(@group),
                     remote: true,
                     method: :post,
                     html: {
                       data: {
                         controller: :preserve_selection,
                         action: 'change->preserve_selection#preserve redmine:before-fetch-request->preserve_selection#save redmine:before-fetch-request->preserve_selection#restore',
                         preserve_selection_selector_value: 'input[name=\"user_ids[]\"]'
                       }
                     }) do |f| %>
  <%= render :partial => 'new_users_form' %>
  <p class="buttons">
    <%= submit_tag l(:button_add) %>
    <%= link_to l(:button_cancel), '#', data: { action: 'dialog#cancel' } %>
  </p>
<% end %>
