<h2><%= l(:label_member_new) %></h2>

<%= form_for @member, as: :membership,
                      url: project_memberships_path(@project),
                      method: :post,
                      html: {
                        data: {
                          controller: :preserve_selection,
                          action: 'change->preserve_selection#preserve redmine:before-fetch-request->preserve_selection#save redmine:before-fetch-request->preserve_selection#restore',
                          preserve_selection_selector_value:'input[name=\"membership[user_ids][]\"]'
                        }
                      } do |f| %>
  <%= render :partial => 'new_form' %>
  <p><%= submit_tag l(:button_add), :name => nil %></p>
<% end %>
